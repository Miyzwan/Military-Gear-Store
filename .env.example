# ──────────────────────────────────────────
# WARZONE TACTICAL — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────
# PostgreSQL connection string (auto-provisioned on Replit)
DATABASE_URL=postgresql://user:password@localhost:5432/warzone

# ── Session ───────────────────────────────
# Secret key for signing session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-64-byte-hex-string

# ── Admin Credentials ─────────────────────
# Initial admin account — seeded automatically on first server startup.
# Change these values and restart the server to update credentials.
# Passwords are stored as bcrypt hashes (never plain text).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── App Config ────────────────────────────
# Node environment: development | production | test
NODE_ENV=development

# Port for the API server (auto-assigned on Replit)
PORT=3000
